{
  "name": "ponto-certo-saas",
  "private": true,
  "version": "0.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "db:init": "npm --workspace apps/api run db:init",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
