# Instale este bloco antes do location /api/ genérico no server HTTPS de
# pontoocerto.duckdns.org. O proxy_pass remove /api e preserva o restante da rota.
location ^~ /api/control-id/device/ {
    access_log off;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3340/control-id/device/;
}
