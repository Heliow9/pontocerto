PORT=3333
NODE_ENV=development

MYSQL_HOST=SEU_HOST_MYSQL
MYSQL_PORT=3306
MYSQL_DATABASE=SEU_BANCO
MYSQL_USER=SEU_USUARIO_MYSQL
MYSQL_PASSWORD=COLOQUE_A_SENHA_REAL_AQUI

JWT_SECRET=troque-por-uma-chave-longa-e-segura
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Opcional: usado para transformar o endereço da empresa em latitude/longitude.
MAPBOX_ACCESS_TOKEN=
FACE_PROVIDER=DISABLED
FACE_MAX_IMAGE_MB=5
# Validação opcional por foto cadastrada. Credenciais somente no servidor.
FACE_MATCH_THRESHOLD=95
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional para credenciais temporárias; IAM Role também é aceito pelo SDK.
AWS_SESSION_TOKEN=

# Gerar uma vez com npm run push:setup; mantenha o par entre deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pontoocerto.duckdns.org
REMINDER_WORKER_ENABLED=1
# Opcional: segurança adicional do Expo Push Service
EXPO_ACCESS_TOKEN=
WHATSAPP_ENCRYPTION_KEY=

# Financeiro SaaS / Banco Inter Empresas
# O certificado e a chave devem ficar FORA do repositório, em pasta protegida no servidor.
FINANCIAL_WORKER_ENABLED=1
INTER_ENABLED=0
INTER_ENV=production
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=/opt/ponto-certo/secrets/inter.crt
INTER_KEY_PATH=/opt/ponto-certo/secrets/inter.key
# Preencha somente se a integração estiver vinculada a mais de uma conta corrente.
INTER_ACCOUNT=
# O Inter aceita de 0 a 60 dias. Este prazo é independente do bloqueio do Ponto Certo.
INTER_BILLING_CANCEL_DAYS=30
# Ex.: https://api.seudominio.com/webhooks/inter/billing
INTER_WEBHOOK_URL=
