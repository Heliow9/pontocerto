# Ponto Certo API — V4.1.3
# Copie para .env e preencha apenas no servidor. Nunca versione credenciais reais.

NODE_ENV=production
PORT=3340
CORS_ORIGINS=https://pontoocerto.duckdns.org
JWT_SECRET=
JWT_EXPIRES_IN=12h

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ponto_certo
MYSQL_USER=
MYSQL_PASSWORD=

# Push / notificações
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@example.com
EXPO_ACCESS_TOKEN=
REMINDER_WORKER_ENABLED=0

# Financeiro
FINANCIAL_WORKER_ENABLED=0

# Cora — Integração Direta (mTLS + Client Credentials)
CORA_ENABLED=0
CORA_ENV=production
CORA_CLIENT_ID=
CORA_CERT_PATH=/opt/ponto-certo/secrets/cora/certificate.pem
CORA_KEY_PATH=/opt/ponto-certo/secrets/cora/private-key.key
CORA_WEBHOOK_URL=https://pontoocerto.duckdns.org/api/webhooks/cora

# Efí
EFI_ENABLED=0
EFI_ENV=production
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_CERT_PATH=
EFI_PIX_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_WEBHOOK_URL=

# Mercado Pago
MP_ENABLED=0
MP_ENV=production
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
MP_BOLETO_PAYMENT_METHOD_ID=bolbradesco

# Bridge Ponto Certo -> Movyo
MOVYO_BRIDGE_ENABLED=0
MOVYO_BRIDGE_BASE_URL=https://api.movyo.delivery
MOVYO_BRIDGE_CLIENT_ID=ponto-certo
MOVYO_BRIDGE_SECRET=
MOVYO_BRIDGE_TIMEOUT_MS=10000
MOVYO_SYNC_WORKER_ENABLED=0

# Geolocalização
MAPBOX_ACCESS_TOKEN=

# Selfie / biometria facial
SELFIE_STORAGE_DIR=storage/selfies
SELFIE_MAX_IMAGE_MB=8
FACE_PROVIDER=AWS_REKOGNITION
FACE_MAX_IMAGE_MB=8
FACE_MATCH_THRESHOLD=90
AWS_REGION=us-east-1

# Documentos / integrações locais
LIBREOFFICE_PATH=
WHATSAPP_ENCRYPTION_KEY=
