PORT=3333
NODE_ENV=development

MYSQL_HOST=SEU_HOST_MYSQL
MYSQL_PORT=3306
MYSQL_DATABASE=SEU_BANCO
MYSQL_USER=SEU_USUARIO_MYSQL
MYSQL_PASSWORD=COLOQUE_A_SENHA_REAL_AQUI

JWT_SECRET=troque-por-uma-chave-longa-e-segura
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Opcional: usado para transformar o endereço da empresa em latitude/longitude.
MAPBOX_ACCESS_TOKEN=
FACE_PROVIDER=DISABLED
FACE_MAX_IMAGE_MB=5
# Validação opcional por foto cadastrada. Credenciais somente no servidor.
FACE_MATCH_THRESHOLD=95
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional para credenciais temporárias; IAM Role também é aceito pelo SDK.
AWS_SESSION_TOKEN=

# Gerar uma vez com npm run push:setup; mantenha o par entre deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pontoocerto.duckdns.org
REMINDER_WORKER_ENABLED=1
# Opcional: segurança adicional do Expo Push Service
EXPO_ACCESS_TOKEN=
WHATSAPP_ENCRYPTION_KEY=

# Financeiro SaaS / provedores de pagamento
# Segredos e certificados devem ficar FORA do Git, em pasta protegida no servidor.
FINANCIAL_WORKER_ENABLED=1

# Cora - Integração Direta
CORA_ENABLED=0
CORA_ENV=production
CORA_CLIENT_ID=
CORA_CERT_PATH=/opt/ponto-certo/secrets/cora.crt
CORA_KEY_PATH=/opt/ponto-certo/secrets/cora.key
CORA_WEBHOOK_URL=https://api.seudominio.com/webhooks/cora

# Efí Bank - Cobranças / Bolix + Pix
EFI_ENABLED=0
EFI_ENV=production
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_CERT_PATH=/opt/ponto-certo/secrets/efi.p12
EFI_PIX_CERT_PASSWORD=
EFI_PIX_KEY=
EFI_WEBHOOK_URL=https://api.seudominio.com/webhooks/efi

# Mercado Pago - Pix ou boleto (não híbrido)
MP_ENABLED=0
MP_ENV=production
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=https://api.seudominio.com/webhooks/mercadopago
MP_BOLETO_PAYMENT_METHOD_ID=bolbradesco
