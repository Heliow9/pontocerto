PORT=3333
NODE_ENV=development

MYSQL_HOST=ponto-certo.mysql.uhserver.com
MYSQL_PORT=3306
MYSQL_DATABASE=ponto_certo
MYSQL_USER=pontocerto_admi
MYSQL_PASSWORD=COLOQUE_A_SENHA_REAL_AQUI

JWT_SECRET=troque-por-uma-chave-longa-e-segura
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Opcional: usado para transformar o endereço da empresa em latitude/longitude.
MAPBOX_ACCESS_TOKEN=
FACE_PROVIDER=DISABLED
FACE_MAX_IMAGE_MB=6

# Gerar uma vez com npm run push:setup; mantenha o par entre deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://pontoocerto.duckdns.org
REMINDER_WORKER_ENABLED=1
# Opcional: segurança adicional do Expo Push Service
EXPO_ACCESS_TOKEN=
